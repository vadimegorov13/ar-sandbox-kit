#!/usr/bin/python3
"""Validate that a projector matrix maps the configured box to the projector."""
import math, pathlib, re, struct, sys

if len(sys.argv) not in (3, 5):
    raise SystemExit("usage: validate-projector-matrix BoxLayout.txt ProjectorMatrix.dat [WIDTH HEIGHT]")
layout, matrix = map(pathlib.Path, sys.argv[1:3])
half_w, half_h = (int(sys.argv[3]) / 2, int(sys.argv[4]) / 2) if len(sys.argv) == 5 else (512, 384)
try:
    text = layout.read_text()
    points = [tuple(map(float, m.groups())) for m in re.finditer(
        r'^\(\s*([-+0-9.eE]+),\s*([-+0-9.eE]+),\s*([-+0-9.eE]+)\)\s*$', text, re.M)]
    values = struct.unpack('<16d', matrix.read_bytes())
except Exception as exc:
    print(f"INVALID: could not read calibration files: {exc}")
    raise SystemExit(2)
if len(points) != 4 or len(values) != 16:
    print("INVALID: expected four box corners and a 128-byte projector matrix")
    raise SystemExit(2)

rows = [values[i*4:(i+1)*4] for i in range(4)]
projected=[]
weights=[]
for point in points:
    v=point+(1.0,)
    q=[sum(rows[r][c]*v[c] for c in range(4)) for r in range(4)]
    if not all(math.isfinite(x) for x in q) or abs(q[3]) < 1e-8:
        print("INVALID: a corner has a non-finite projection")
        raise SystemExit(3)
    projected.append((q[0]/q[3], q[1]/q[3]))
    weights.append(q[3])

xs=[p[0] for p in projected]; ys=[p[1] for p in projected]
xspan=max(xs)-min(xs); yspan=max(ys)-min(ys)
print("Projected box corners (projector pixels):")
for index,(x,y) in enumerate(projected,1):
    print(f"  {index}: ({(x+1)*half_w:.1f}, {(y+1)*half_h:.1f})")
print(f"Projected span: {xspan*half_w:.1f} × {yspan*half_h:.1f} pixels")

same_weight_sign=all(w>0 for w in weights) or all(w<0 for w in weights)
reasonable=(same_weight_sign and 0.5<=xspan<=3.0 and 0.5<=yspan<=3.0
            and max(abs(v) for v in xs+ys)<=2.0)
if not reasonable:
    print("INVALID: the matrix places the sandbox substantially outside the projector image.")
    raise SystemExit(4)
print("VALID: projector coverage is plausible.")
